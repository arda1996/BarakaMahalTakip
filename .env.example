# Servisin kendi ayarlari
APP_ENV=dev

# Kimlik bilgilerini sifrelemek icin. Kurulum betigi bunu otomatik doldurur.
# Elle uretmek isterseniz:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Trendyol Go istekleri icin. TGO_EXECUTOR_USER'i bos birakabilirsiniz:
# baglanti eklerken girdiginiz e-posta kullanilir. Buraya yazarsaniz
# e-posta girilmeyen baglantilar icin varsayilan olur.
TGO_AGENT_NAME=SelfIntegration
TGO_EXECUTOR_USER=

# Veritabani yeri. Bos birakilirsa her iki modda da ayni yer kullanilir:
#   C:\Users\<kullanici>\AppData\Local\BarakaMahalServis\connections.db
# Boylece hesabi bir kez baglarsiniz, exe'yi yeniden uretseniz bile
# tekrar sormaz.
# DB_PATH=
